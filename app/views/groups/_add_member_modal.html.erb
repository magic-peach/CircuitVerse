<div id="add-member-panel" class="cv-inline-panel" role="region" aria-label="<%= t('add_members') %>">
  <div class="cv-inline-panel-inner">
    <div class="cv-panel-header">
      <strong style="color:#0F6E56; font-size:0.9rem;"><%= t("add_members") %></strong>
      <button type="button" class="cv-panel-close" onclick="closeCvPanel('add-member-panel')" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <% if group_member.group.allowed_domain.present? %>
      <div style="background:#FFF9E6; border:1px solid #F6D860; border-radius:6px; padding:8px 12px; font-size:0.8rem; color:#7A6000; margin-bottom:12px;">
        <strong>Restricted:</strong> Users must have a <code><%= group_member.group.allowed_domain %></code> email address to join.
      </div>
    <% end %>

    <div class="cv-panel-or-divider">
      <hr><span>Choose an option below</span><hr>
    </div>

    <div style="display:flex; gap:12px; align-items:stretch;">
      <div style="flex:1;">
        <h4 style="margin-top:0; margin-bottom:12px; color:#0F6E56; font-size:0.9rem;">Add Members by Invite Link</h4>
        <p style="font-size:0.82rem; color:#666; margin-bottom:12px;">Generate and share an invite link. Users can join by clicking link.</p>

        <div style="background:#F8FFF9; border:1px solid #D1EDE4; border-radius:6px; padding:16px;">
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
            <%= button_to generate_token_group_path,
                { remote: true, method: :put,
                  class: "cv-add-btn",
                  "data-bs-toggle": "collapse",
                  href: "#group-invite-link-container",
                  "aria-expanded": "false",
                  "aria-controls": "group-invite-link-container" } do %>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 7.54.54l3-3a5 5 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 7.54-.54l-3 3a5 5 0 0-7.07 7.07l1.71-1.71"/></svg>
              <%= t("groups.invite_link_btn", default: "Generate invite link") %>
            <% end %>
          </div>
          <div class="collapse" id="group-invite-link-container" style="width:100%;">
            <div style="display:flex; align-items:center; gap:8px; margin-top:8px;">
              <textarea readonly="readonly" id="embedInviteLink"
                        class="form-control group-invite-link-text"
                        rows="2" name="group-invite-link"
                        style="font-size:0.8rem; resize:none; background:#f8f9fa;"></textarea>
              <button type="button" onclick="copyInviteLink()" title="Copy to clipboard"
                          class="cv-icon-btn cv-icon-btn--swap" style="flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div style="flex:1;">
        <h4 style="margin-top:0; margin-bottom:12px; color:#0F6E56; font-size:0.9rem;">Add Member by Email</h4>
        <p style="font-size:0.82rem; color:#666; margin-bottom:12px;">Add a user directly by their email address. Useful when you don't want to use invite links.</p>

        <%= form_with(url: add_member_by_email_group_path(@group), method: :post, local: true) do |form| %>
          <div style="background:#F8FFF9; border:1px solid #D1EDE4; border-radius:6px; padding:16px;">
            <div class="form-group mb-3">
              <%= form.label :email, "Email Address", class: "form-label" %>
              <%= form.email_field :email, class: "form-control", placeholder: "user@example.com" %>
              <small class="form-text text-muted">Enter a single email address</small>
            </div>

            <div style="margin-top:12px;">
              <%= form.submit "Add Member", class: "btn primary-button" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
function copyInviteLink() {
  var textarea = document.getElementById('embedInviteLink');
  textarea.select();
  document.execCommand('copy');
}
</script>
